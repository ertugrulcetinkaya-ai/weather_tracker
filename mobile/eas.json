{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "distribution": "internal",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://weather-tracker-nine-delta.vercel.app"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
